   "source": [
    "## Raw Count"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 135,
   "metadata": {},
   "outputs": [],
   "source": [
    "columns = ['pubchem', 'chembl', 'bindingdb', 'stitch','ctd', 'dtc', 'otp', 'drugcentral', 'drugbank', 'pc_inchikey']\n",
    "dat = cpe[columns]\n",
    "\n",
    "# Melt the DataFrame to have a single column for sources\n",
    "melted_df = pd.melt(dat, id_vars=['pc_inchikey'], var_name='Source', value_name='Interaction')\n",
    "\n",
    "# Filter rows with interactions\n",
    "interacting_sources = melted_df[melted_df['Interaction'] == 1]\n",
    "\n",
    "# Group by Source and count unique compounds\n",
    "source_counts = interacting_sources.groupby('Source')['pc_inchikey'].nunique().reset_index()\n",
    "\n",
    "source_counts.rename(columns={'pc_inchikey': 'count'}, inplace=True)\n",
    "\n",
    "source_ints = dat.drop(columns='pc_inchikey').sum()\n",
    "source_ints = source_ints.reset_index()\n",
    "\n",
    "source_ints.rename(columns={'index': 'source', 0:'count'}, inplace=True)\n",
    "source_ints.sort_values(by='source', inplace=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 141,
   "metadata": {},
   "outputs": [],
   "source": [
    "source_counts.loc[9,'Source']='CPIExtract'\n",
    "source_counts.loc[9,'count']=len(dat['pc_inchikey'].unique())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 148,
   "metadata": {},
   "outputs": [],
   "source": [
    "source_ints.loc[9,'Source']='CPIExtract'\n",
    "source_ints.loc[9,'count']=len(dat)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 156,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
