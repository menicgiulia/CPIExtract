    "# Plots Figure 1e-f\n",
    "This notebook provides the code to reproduce the figures in the paper"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 162,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patches as mpatches\n",
    "import matplotlib.ticker as ticker\n",
    "from matplotlib.patches import Patch"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 108,
   "metadata": {},
   "outputs": [],
   "source": [
    "cpe = pd.read_csv('CPIE_FB_final_v2.csv',low_memory=False)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Distributions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 110,
   "metadata": {},
   "outputs": [],
   "source": [
    "cpe=cpe.loc[~cpe['pc_inchikey'].isna()]\n",
    "clean = cpe.loc[cpe['ave_pchembl'] != 'Sources do not provide activity data']\n",
    "clean = clean.copy()\n",
    "clean['ave_pchembl'] = clean['ave_pchembl'].astype(float)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 112,
   "metadata": {},
   "outputs": [],
   "source": [
    "densities = {}\n",
    "#Column to compare on\n",
    "#comp_col='pc_firstblock'\n",
    "comp_col='pc_inchikey'\n",
    "\n",
    "for thresh in [6, 8]:\n",
    "    cpie_cnts = clean.loc[(clean['ave_pchembl'] > thresh), comp_col].value_counts()\n",
    "    densities[f'CPIExtract pChEMBL > {thresh}'] = cpie_cnts\n",
    "\n",
    "for thresh in [6, 8]:\n",
    "    db_cnts = clean.loc[(clean['ave_pchembl'] > thresh) & (clean['drugbank'] == 1), comp_col].value_counts()\n",
    "    densities[f'DB pChEMBL > {thresh}'] = db_cnts\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 114,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "CPIExtract pChEMBL > 6: 4.172453044963005\n",
      "CPIExtract pChEMBL > 8: 2.825771324863884\n",
      "DB pChEMBL > 6: 2.6487341772151898\n",
      "DB pChEMBL > 8: 1.8454545454545455\n"
     ]
    },
    {
     "data": {
      "image/png": "",
